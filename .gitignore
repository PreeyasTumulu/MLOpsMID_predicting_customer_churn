# ---------------------------------------------------------------------------
# Data -- tracked by DVC, never by git (requirement #3).
# The raw CSVs are ~27 MB combined; committing them defeats the whole point.
# ---------------------------------------------------------------------------
data/raw/*.csv
data/processed/
!data/**/.gitkeep

# DVC internals (dvc init writes its own .gitignore too; this is a safety net)
/.dvc/cache
/.dvc/tmp
/.dvc/config.local
/dvcstore/

# ---------------------------------------------------------------------------
# MLflow -- local tracking store. Evidence for grading is screenshots of the
# UI, not the raw store.
# ---------------------------------------------------------------------------
mlruns/
mlartifacts/
mlflow.db

# ---------------------------------------------------------------------------
# Model binaries -- regenerated by `dvc repro`
# ---------------------------------------------------------------------------
models/*.pkl
models/*.joblib

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Environments
.venv/
venv/
env/
.env

# Testing / linting caches
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Notebooks
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
